LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM — DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# STT — Cartesia (https://play.cartesia.ai/keys)
CARTESIA_API_KEY=

# TTS — voice output. Pick the vendor with TTS_PROVIDER: "elevenlabs" or
# "cartesia". Cartesia needs no extra key (it reuses CARTESIA_API_KEY above),
# which makes it the quickest fallback when a voice account runs out of credit
# — the symptom of that is a silent agent, not an obvious error.
# TTS_PROVIDER=elevenlabs

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# Knowledge base (optional). Without QDRANT_URL the agent runs without RAG.
# ---------------------------------------------------------------------------

# Qdrant Cloud (https://cloud.qdrant.io/)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_caller_knowledge

# ---------------------------------------------------------------------------
# Telephony (optional) - LiveKit Phone Numbers
#
# Needs no extra credentials: LiveKit rents the number and routes the call, so
# there is no carrier account and no SIP trunk for inbound. Set it up with:
#   uv run python scripts/setup_telephony.py --search      # find a number
#   uv run python scripts/setup_telephony.py --rent        # rent it (asks first)
#   uv run python scripts/setup_telephony.py --write-env   # route it to the agent
#
# Every LiveKit plan includes one free US local number. Numbers are US-only and
# inbound-only today; see the outbound note below.
# ---------------------------------------------------------------------------

# --- Written by setup_telephony.py --write-env -----------------------------
# LIVEKIT_SIP_DISPATCH_RULE_ID=
# Caller ID for outbound; defaults to the first active number.
# TELEPHONY_CALLER_ID=

# --- Outbound calling ------------------------------------------------------
# LiveKit Phone Numbers does not support outbound yet, so placing calls needs a
# LiveKit outbound trunk pointed at a carrier. With this unset, the dialer
# reports outbound as unavailable and inbound still works.
# https://docs.livekit.io/telephony/making-calls/outbound-trunk
# LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# --- Call guardrails -------------------------------------------------------
# Enforced in code before any call is placed, not in the prompt. Emergency and
# premium numbers are always blocked and cannot be re-enabled here.

# Only these numbers may be called. The safest setting while testing: a wrong
# digit then cannot reach a stranger. Comma-separated, E.164.
#
# REQUIRED for any deployment that is publicly reachable with no
# TELEPHONY_API_KEY and has an outbound trunk configured — the server refuses
# to start without it, because otherwise anyone who finds the URL could dial
# any number at your expense. See DEPLOY.md.
# TELEPHONY_ALLOWED_NUMBERS=+971501234567
# TELEPHONY_BLOCKED_NUMBERS=
# Country calling codes the dialer may reach. Empty means no restriction.
# TELEPHONY_ALLOWED_COUNTRIES=971,91
# TELEPHONY_MAX_CONCURRENT_CALLS=5
# TELEPHONY_CALLS_PER_MINUTE=10
# Hard ceiling on one call, so a stuck call cannot bill forever (seconds).
# TELEPHONY_MAX_CALL_DURATION_S=900
# TELEPHONY_RING_TIMEOUT_S=30

# --- Control plane (the dialer UI talks to this) ---------------------------
# On Railway (or any PaaS) leave both of these unset: $PORT is injected at run
# time and also selects the 0.0.0.0 bind. Setting them explicitly overrides it.
# TELEPHONY_API_HOST=127.0.0.1
# TELEPHONY_API_PORT=8080
# Required to bind anywhere other than localhost: this endpoint can place calls.
# TELEPHONY_API_KEY=
# Acknowledges an intentionally public bind with no API key — which is what a
# PaaS deployment is. Without it the server refuses to start on 0.0.0.0.
# TELEPHONY_ALLOW_PUBLIC=false
# Only needed if a browser calls the API directly instead of through Vite.
# TELEPHONY_CORS_ORIGINS=http://localhost:3000
# Prefix for phone-call room names; also how live calls are found.
# TELEPHONY_ROOM_PREFIX=call

# --- Deployed web service (ai_caller.webapp) -------------------------------
# In development Vite serves the UI and mints browser tokens. In production
# `python -m ai_caller.webapp` does both. Defaults are correct in the Docker
# image, where the build lands at frontend/dist.
# FRONTEND_DIST=frontend/dist
# WEB_TOKEN_TTL_MINUTES=15

# ---------------------------------------------------------------------------
# Optional tuning — every line below has a working default.
# ---------------------------------------------------------------------------

# AGENT_NAME=my-agent

# How retrieved context reaches the LLM:
#   auto  inject before generation (default, lowest latency)
#   tool  expose a search tool the LLM calls when it decides to
#   both  inject and expose the tool
#   off   disable retrieval, keep ingestion working
# RAG_MODE=auto
# RAG_TOP_K=4
# Cosine similarity floor, below which retrieved context is dropped. Tuned for
# gemini-embedding-001; a different EMBEDDING_MODEL needs a different value.
# RAG_SCORE_THRESHOLD=0.65
# RAG_TIMEOUT_S=3.0
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120
# KNOWLEDGE_DIR=knowledge

# Embeddings run via Gemini
# Changing the model changes vector dimensions — re-ingest with --recreate.
GEMINI_API_KEY=
# EMBEDDING_MODEL=models/gemini-embedding-001

# Model overrides
# DEEPSEEK_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.6
# CARTESIA_STT_MODEL=ink-2
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Used when TTS_PROVIDER=cartesia. List voices at https://play.cartesia.ai/voices
# CARTESIA_TTS_MODEL=sonic-2
# CARTESIA_VOICE_ID=33d406dd-ff6f-4be7-a7f5-8b1ba183b3e4
